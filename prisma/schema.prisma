generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["events_schema"]
}

enum EventCategory {
  ACADEMICO
  DEPORTIVO
  CULTURAL
  ESTUDIANTIL
  INSTITUCIONAL
  BIENESTAR

  @@schema("events_schema")
}

enum EventStatus {
  BORRADOR
  PENDIENTE_APROBACION
  PUBLICADO
  RECHAZADO
  CANCELADO
  ARCHIVADO
  REUBICACION_LOGISTICA_PENDIENTE

  @@schema("events_schema")
}

enum AccessType {
  LIBRE
  REGISTRO_PREVIO
  EXCLUSIVO_FACULTAD

  @@schema("events_schema")
}

model Event {
  id                   String              @id @default(uuid())
  title                String
  description          String
  category             EventCategory
  facultyId            String?             @map("faculty_id")
  organizerId          String              @map("organizer_id")
  organizerName        String              @map("organizer_name")
  buildingId           String              @map("building_id")
  specificLocation     String              @map("specific_location")
  startTime            DateTime            @map("start_time")
  endTime              DateTime            @map("end_time")
  originalEndTime      DateTime            @map("original_end_time")
  status               EventStatus         @default(PENDIENTE_APROBACION)
  accessType           AccessType          @default(LIBRE) @map("access_type")
  price                Decimal             @default(0.00) @map("price") @db.Decimal(10, 2)
  isPublic             Boolean             @default(true) @map("is_public")
  requiresRegistration Boolean             @default(false) @map("requires_registration")
  maxCapacity          Int?                @map("max_capacity")
  availableCapacity    Int?                @map("available_capacity")
  imageUrl             String?             @map("image_url")
  rejectionReason      String?             @map("rejection_reason")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  registrations        EventRegistration[]
  reports              EventReport[]
  favorites            EventFavorite[]

  @@index([status, startTime, endTime])
  @@index([buildingId, status])
  @@index([facultyId, status])
  @@map("events")
  @@schema("events_schema")
}

enum RegistrationStatus {
  CONFIRMADA
  CANCELADA

  @@schema("events_schema")
}

model EventRegistration {
  id           String             @id @default(uuid())
  eventId      String             @map("event_id")
  userId       String             @map("user_id")
  registeredAt DateTime           @default(now()) @map("registered_at")
  cancelledAt  DateTime?          @map("cancelled_at")
  status       RegistrationStatus @default(CONFIRMADA)
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
  @@map("event_registrations")
  @@schema("events_schema")
}

enum ReportStatus {
  RECIBIDO
  EN_REVISION
  RESUELTO
  DESESTIMADO

  @@schema("events_schema")
}

model EventReport {
  id              String       @id @default(uuid())
  eventId         String       @map("event_id")
  reporterUserId  String       @map("reporter_user_id")
  reason          String
  description     String?
  status          ReportStatus @default(RECIBIDO)
  reviewedBy      String?      @map("reviewed_by")
  reviewedAt      DateTime?    @map("reviewed_at")
  resolutionNotes String?      @map("resolution_notes")
  createdAt       DateTime     @default(now()) @map("created_at")
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, reporterUserId])
  @@index([status])
  @@map("event_reports")
  @@schema("events_schema")
}

model EventFavorite {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_favorites")
  @@schema("events_schema")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventCategory {
  ACADEMICO
  DEPORTIVO
  CULTURAL
  ESTUDIANTIL
  INSTITUCIONAL
}

enum EventStatus {
  BORRADOR
  PENDIENTE_APROBACION
  PUBLICADO
  RECHAZADO
  CANCELADO
  ARCHIVADO
}

model Event {
  id                   String              @id @default(uuid())
  title                String
  description          String
  category             EventCategory
  facultyId            String?             @map("faculty_id")
  organizerId          String              @map("organizer_id")
  organizerName        String              @map("organizer_name")
  buildingId           String              @map("building_id")
  specificLocation     String              @map("specific_location")
  startTime            DateTime            @map("start_time")
  endTime              DateTime            @map("end_time")
  status               EventStatus         @default(PENDIENTE_APROBACION)
  isPublic             Boolean             @default(true) @map("is_public")
  requiresRegistration Boolean             @default(false) @map("requires_registration")
  maxCapacity          Int?                @map("max_capacity")
  availableCapacity    Int?                @map("available_capacity")
  imageUrl             String?             @map("image_url")
  rejectionReason      String?             @map("rejection_reason")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  registrations        EventRegistration[]
  reports              EventReport[]

  @@index([status, startTime, endTime])
  @@index([buildingId, status])
  @@map("events")
  @@schema("events_schema")
}

enum RegistrationStatus {
  CONFIRMADA
  CANCELADA
}

model EventRegistration {
  id           String             @id @default(uuid())
  eventId      String             @map("event_id")
  userId       String             @map("user_id")
  registeredAt DateTime           @default(now()) @map("registered_at")
  status       RegistrationStatus @default(CONFIRMADA)
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_registrations")
  @@schema("events_schema")
}

enum ReportStatus {
  RECIBIDO
  EN_REVISION
  RESUELTO
  DESESTIMADO
}

model EventReport {
  id             String       @id @default(uuid())
  eventId        String       @map("event_id")
  reporterUserId String       @map("reporter_user_id")
  reason         String
  description    String?
  status         ReportStatus @default(RECIBIDO)
  reviewedBy     String?      @map("reviewed_by")
  resolutionNotes String?     @map("resolution_notes")
  createdAt      DateTime     @default(now()) @map("created_at")
  event          Event        @relation(fields: [eventId], references: [id])

  @@map("event_reports")
  @@schema("events_schema")
}
